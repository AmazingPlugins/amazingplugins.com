{
  "name": "marketing-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/ai-readiness/render-ai-files.ts && astro build",
    "ai:files": "tsx scripts/ai-readiness/render-ai-files.ts",
    "ai:audit": "tsx scripts/ai-readiness/audit.ts",
    "ai:rate-limit": "tsx scripts/ai-readiness/cloudflare-rate-limit.ts",
    "ai:indexnow": "tsx scripts/ai-readiness/indexnow.ts",
    "preview": "astro preview",
    "astro": "astro",
    "seo:generate": "tsx scripts/seo-pipeline/generate-post.ts",
    "seo:submit": "tsx scripts/seo-pipeline/gsc-submit.ts",
    "seo:health": "tsx scripts/seo-pipeline/gsc-health.ts",
    "seo:fix": "tsx scripts/seo-pipeline/fix-404s.ts",
    "seo:pipeline": "tsx scripts/seo-pipeline/index.ts",
    "seo:keywords": "tsx scripts/seo-pipeline/keywords.ts",
    "seo:bing:health": "tsx scripts/seo-pipeline/bing-health.ts",
    "seo:bing:submit": "tsx scripts/seo-pipeline/bing-submit.ts",
    "test:seo-quality": "tsx scripts/seo-pipeline/content-quality.test.ts",
    "test:gsc-reporting": "node --import tsx --test scripts/seo-pipeline/gsc-reporting.test.ts",
    "test:ai-readiness": "node --import tsx --test scripts/ai-readiness/ai-readiness.test.ts",
    "test:footer-badges": "node --test tests/footer-badges-html.test.mjs",
    "test:seo-current": "tsx scripts/seo-pipeline/check-current-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@astrojs/cloudflare": "^13.1.10",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.8",
    "google-auth-library": "^9.15.0",
    "googleapis": "^140.0.1",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.91.0"
  }
}
