---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-col">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
          <img src="/images/logo.jpg" alt="AmazingPlugins" width="28" height="28" style="border-radius:6px;object-fit:cover;" />
          <strong style="font-size:15px;">AmazingPlugins</strong>
        </div>
        <p style="font-size:14px;color:var(--ink-3);max-width:280px;line-height:1.55;">
          A small studio building useful plugins for WooCommerce. Free, all crafted.
        </p>
      </div>
      <div class="footer-col">
        <h5>Plugins</h5>
        <a href="/plugins/woocommerce-accessibility-fixer/">WooCommerce Accessibility Fixer</a>
        <a href="/plugins/">All Plugins</a>
      </div>
      <div class="footer-col">
        <h5>Company</h5>
        <a href="/blog/">Blog</a>
      </div>
      <div class="footer-col">
        <h5>Legal</h5>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </div>
      <div class="footer-col">
        <h5>Support</h5>
        <a href="mailto:support@amazingplugins.com">Email support</a>
        <a href="mailto:accessibility@amazingplugins.com">Accessibility</a>
      </div>
    </div>
    <div class="footer-badges" aria-label="Featured on IndieHunt, Fazier, Wired Business, ProductFame, ShowMeBestAI, and Neeed Directory">
      <a href="https://indiehunt.io" target="_blank" rel="noopener noreferrer">
        <img src="https://indiehunt.io/badges/indiehunt-badge-light.svg" alt="Featured on IndieHunt" width="265" height="58" />
      </a>
      <a href="https://fazier.com/launches/amazingplugins.com" target="_blank"><img src="https://fazier.com/api/v1//public/badges/launch_badges.svg?badge_type=launched&theme=light" width="120" alt="Fazier badge" /></a>
      <a href="https://wired.business" target="_blank"><img src="https://wired.business/badge0-white.svg" alt="Featured on Wired Business" width="200" height="54"></a>
      <a href="https://productfame.com" target="_blank" rel="noopener noreferrer">
        <img src="https://productfame.com/badges/featured-light.svg" alt="Featured on ProductFame" width="245" height="54" />
      </a>
      <a href="https://showmebest.ai" target="_blank"><img src="https://showmebest.ai/badge/feature-badge-white.webp" alt="Featured on ShowMeBestAI" width="220" height="60"></a>
      <a href="https://neeed.directory" target="_blank" rel="noopener noreferrer">
        <img src="https://neeed.directory/badges/neeed-badge-light.svg" alt="Featured on Neeed Directory" />
      </a>
    </div>
    <div class="footer-bot">
      <span>&copy; {new Date().getFullYear()} AmazingPlugins.</span>
      <span>All systems normal</span>
    </div>
  </div>
</footer>
