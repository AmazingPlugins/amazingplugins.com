---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { shippingTester, shippingFAQs } from '../data/shipping-rules-tester';

const groups = [
  {
    id: 'choosing-a-plugin', title: 'Choosing a plugin', href: '/plugins/', link: 'Compare all plugins',
    questions: [
      { question: 'Which plugin should I use?', answer: 'Accessibility Fixer addresses common storefront accessibility issues. Shipping Rules Tester helps investigate zones and local shipping rates. Stale Order Cleaner finds old orders by status and age for review before deletion. Install the tool that matches the problem you need to solve.' },
      { question: 'Where do I find the current install links?', answer: 'Accessibility Fixer is available on WordPress.org. Shipping Rules Tester is submitted for review, with its source available on GitHub. Stale Order Cleaner is available through its GitHub repository. The plugin catalog links to each current install or source page.' },
      { question: 'What should I include in a support request?', answer: 'Tell us the plugin name and version, your WordPress and WooCommerce versions, the steps you took, and what you expected to happen. Include a screenshot or error message if it helps explain the issue. Leave passwords, API keys, and customer information out of the message.' },
    ],
  },
  { id: 'shipping-rules-tester', title: 'Shipping Rules Tester', href: shippingTester.path, link: 'Explore Shipping Rules Tester', questions: shippingFAQs },
  {
    id: 'accessibility-fixer', title: 'Accessibility Fixer', href: '/plugins/woocommerce-accessibility-fixer/', link: 'Explore Accessibility Fixer',
    questions: [
      { question: 'Does Accessibility Fixer replace an accessibility review?', answer: 'No. It helps address common issues such as missing image alt text and form labels. You still need to check whether descriptions are meaningful and whether visitors can complete your actual shopping and checkout flows. Installing a plugin does not certify compliance.' },
      { question: 'Will it work with my theme and checkout?', answer: 'Theme overrides, custom templates, and other extensions can affect the result. Check the relevant storefront pages after applying fixes and after updates. If you find a conflict, contact support with the theme name, plugin versions, and steps to reproduce it.' },
      { question: 'Where can I check compatibility before installing?', answer: 'Use the current WordPress.org listing for requirements, the changelog, and installation instructions. Check those requirements against your store before installing or updating.' },
    ],
  },
  {
    id: 'stale-order-cleaner', title: 'Stale Order Cleaner', href: '/plugins/#stale-order-cleaner', link: 'See order cleanup features',
    questions: [
      { question: 'Which orders can Stale Order Cleaner remove?', answer: 'It finds pending, failed, cancelled, draft, and trashed orders using status and minimum-age filters. Completed, processing, and on-hold orders are excluded from cleanup. Run a dry scan to review the matching records before deletion.' },
      { question: 'Can I undo an order deletion?', answer: 'No. Deletion permanently removes matching order records. Review the dry-run results and keep a backup before cleanup. Deleting an order does not delete the customer account.' },
      { question: 'Does Stale Order Cleaner work with HPOS?', answer: 'Yes. It supports both legacy WooCommerce order tables and High-Performance Order Storage (HPOS).' },
    ],
  },
];
---

<BaseLayout title="WooCommerce Plugin FAQs" description="Answers about Shipping Rules Tester, Accessibility Fixer, and Stale Order Cleaner: installation, compatibility, read-only checks, and order cleanup.">
  <BreadcrumbSchema items={[{ name: 'Home', url: '/' }, { name: 'FAQ', url: '/faq/' }]} />
  <FAQSchema questions={groups.flatMap(group => group.questions)} />
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Before you install</div>
      <h1 class="display">A few useful <em>answers.</em></h1>
      <p class="lede">Find the right plugin, check what it supports, and know what to expect before running it on your store.</p>
      <nav aria-label="FAQ topics" class="topic-links">
        {groups.map(group => <a class="btn btn-ghost" href={`#${group.id}`}>{group.title}</a>)}
      </nav>
    </div>
  </section>

  {groups.map(group => (
    <section class="section faq-group" id={group.id} aria-labelledby={`${group.id}-heading`}>
      <div class="wrap faq-wrap">
        <h2 class="display" id={`${group.id}-heading`}>{group.title}</h2>
        {group.questions.map(faq => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
        <a class="text-link" href={group.href}>{group.link}</a>
        {group.id === 'shipping-rules-tester' && <p class="guide-link">Working through a missing rate? Read <a class="text-link" href="/blog/how-to-test-woocommerce-shipping-zones-and-rates/">how to test WooCommerce shipping zones and rates</a>.</p>}
      </div>
    </section>
  ))}

  <section class="section support">
    <div class="wrap faq-wrap">
      <h2 class="display">Still have a question?</h2>
      <p>Tell us which plugin you're using and what you're trying to do.</p>
      <a href="mailto:support@amazingplugins.com" class="btn btn-primary">Contact support</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--cream-2); padding: 64px 0; }
  h1 { font-size: clamp(40px, 6vw, 76px); margin: 20px 0 28px; }
  .topic-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .topic-links .btn { white-space: normal; }
  .faq-wrap { max-width: 960px; }
  .faq-group { scroll-margin-top: 68px; padding-top: 56px; padding-bottom: 24px; }
  h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 28px; }
  details { border-bottom: 1px solid var(--line); padding: 20px 0; }
  summary { cursor: pointer; font-weight: 600; padding: 4px 0; }
  details p { color: var(--ink-2); line-height: 1.7; margin-top: 16px; max-width: 72ch; }
  .text-link { text-decoration: underline; text-underline-offset: 4px; }
  .faq-wrap > .text-link { display: inline-block; margin-top: 24px; }
  .guide-link { margin-top: 20px; color: var(--ink-2); }
  .support { background: var(--cream-2); margin-top: 56px; }
  .support p { margin: 20px 0 28px; color: var(--ink-2); }
</style>
