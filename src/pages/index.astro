---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQSection from '../components/FAQSection.astro';
import { shippingTester } from '../data/shipping-rules-tester';

const questions = [
  { question: 'Which plugin should I start with?', answer: 'Use Accessibility Fixer for common accessibility issues in your WooCommerce storefront. Shipping Rules Tester helps investigate shipping zones and local rates. Stale Order Cleaner finds old pending, failed, cancelled, draft, or trashed orders for review before deletion.' },
  { question: 'Where can I install the plugins?', answer: 'Accessibility Fixer is available on WordPress.org. Shipping Rules Tester has been submitted for review, with its source available on GitHub. Stale Order Cleaner is also available through its GitHub repository. Each plugin listing links to its current source or install page.' },
  { question: 'Do I need all the plugins?', answer: 'No. Each plugin has a separate job. Choose the one that matches your store’s problem and check its requirements before installing.' },
];

// Organization schema for homepage
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AmazingPlugins",
  "url": "https://amazingplugins.com",
  "description": "Free WooCommerce plugins for accessibility fixes, shipping rule checks, and order cleanup.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": "https://amazingplugins.com/faq/"
  }
};
---

<BaseLayout title="Free WooCommerce Plugins for Your Store" description="Fix accessibility issues, check shipping zones and local rates, or clean up stale orders. Explore free WooCommerce plugins with clear setup guides.">
  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Hero -->
  <section class="hero-wrap" id="hero-section">
    <div class="ribbon-bg ribbon-anim" style="top:-120px;right:-200px;width:1100px;opacity:0.55;" aria-hidden="true">
      <svg viewBox="0 0 1000 320" fill="none" width="1100">
        <defs><linearGradient id="rg-a" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#F4A93C" stop-opacity="0.9"/><stop offset="40%" stop-color="#F26B3A"/><stop offset="70%" stop-color="#E85A78"/><stop offset="100%" stop-color="#5B3A6B"/></linearGradient></defs>
        <path d="M 50 200 Q 200 80 380 180 T 720 220 Q 880 240 950 120" stroke="url(#rg-a)" stroke-width="64" stroke-linecap="round" fill="none"/>
        <path d="M 50 200 Q 200 80 380 180 T 720 220 Q 880 240 950 120" stroke="rgba(255,255,255,0.25)" stroke-width="20" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
    <div class="ribbon-bg ribbon-anim" style="bottom:-200px;left:-150px;width:900px;opacity:0.22;animation-delay:2s;" aria-hidden="true">
      <svg viewBox="0 0 1000 320" fill="none" width="900">
        <defs><linearGradient id="rg-b" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#F4A93C" stop-opacity="0.9"/><stop offset="40%" stop-color="#F26B3A"/><stop offset="70%" stop-color="#E85A78"/><stop offset="100%" stop-color="#5B3A6B"/></linearGradient></defs>
        <path d="M 0 100 Q 200 220 400 140 T 800 200" stroke="url(#rg-b)" stroke-width="64" stroke-linecap="round" fill="none"/>
        <path d="M 0 100 Q 200 220 400 140 T 800 200" stroke="rgba(255,255,255,0.25)" stroke-width="20" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
    <div class="grain"></div>
    <div class="wrap hero-content">
      <div class="chip" style="margin-bottom:36px;">
        <span class="chip-dot"></span>
        <span>Free tools for everyday store work.</span>
      </div>
      <h1 class="display hero-h1">
        A <em>house</em> of plugins for WooCommerce.
      </h1>
      <p class="lede hero-lede">
        Fix common accessibility issues, investigate shipping rules, and clear out stale orders. Pick the tool for the job, right inside WooCommerce.
      </p>
      <div class="hero-btns">
        <a href="/plugins/" class="btn btn-primary" style="padding:16px 28px;font-size:16px;">
          Browse plugins
          <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
        <a href={shippingTester.path} class="btn btn-ghost">Explore Shipping Rules Tester</a>
      </div>
    </div>
  </section>

  <!-- Plugin Tiles -->
  <section class="section">
    <div class="wrap">
      <div class="catalog-header">
        <div>
          <div class="eyebrow" style="margin-bottom:16px;">The catalog</div>
          <h2 class="display" style="font-size:clamp(36px,5vw,72px);max-width:18ch;">
            A few store problems, <em>covered.</em>
          </h2>
        </div>
        <a href="/plugins/" class="btn btn-ghost">
          View all plugins
          <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      </div>
      <div class="tiles-grid">
        <a href="/plugins/woocommerce-accessibility-fixer/" class="tile tile-accessibility" style="padding:32px;min-height:240px;display:flex;flex-direction:column;justify-content:space-between;gap:28px;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.85;">01 · WooCommerce</span>
          </div>
          <div>
            <h3 class="display" style="font-size:32px;letter-spacing:-0.02em;line-height:1.05;">Accessibility Fixer</h3>
            <p class="tile-description">Address missing image alt text, form labels, and other common storefront accessibility issues.</p>
            <span class="tile-action">View plugin details <span aria-hidden="true">↗</span></span>
          </div>
        </a>
        <a href={shippingTester.path} class="tile tile-grad-3 product-tile">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <span class="review-badge">{shippingTester.status}</span>
          </div>
          <div>
            <h3 class="display" style="font-size:32px;letter-spacing:-0.02em;line-height:1.05;">Shipping Rules Tester</h3>
            <p class="tile-description">Check which zone and local rates match a sample package. Compare results without changing settings.</p>
            <span class="tile-action">View plugin details <span aria-hidden="true">↗</span></span>
          </div>
        </a>
        <a href="/plugins/#stale-order-cleaner" class="tile tile-grad-cream product-tile">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <span class="eyebrow">Source on GitHub</span>
          </div>
          <div>
            <h3 class="display" style="font-size:32px;letter-spacing:-0.02em;line-height:1.05;">Stale Order Cleaner</h3>
            <p class="tile-description">Find old pending, failed, and cancelled orders. Preview the matching records before permanent deletion.</p>
            <span class="tile-action">View plugin details <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Beliefs -->
  <section class="section">
    <div class="wrap">
      <div class="beliefs-header">
        <div><div class="eyebrow" style="margin-bottom:16px;">What we believe</div></div>
        <h2 class="display" style="font-size:clamp(36px,5vw,64px);max-width:20ch;">
          Choose by the problem <em>in front of you.</em>
        </h2>
      </div>
      <div class="beliefs-grid">
        <div class="belief-cell">
          <div style="font-family:var(--font-mono);font-size:11px;color:var(--ink-3);letter-spacing:0.14em;margin-bottom:28px;text-transform:uppercase;">01 · Accessibility</div>
          <h3 class="display" style="font-size:28px;margin-bottom:16px;letter-spacing:-0.02em;">Make your storefront easier to use.</h3>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.55;">Start with common markup issues such as missing alt text and form labels. Then test your store with a keyboard and assistive technology. A plugin doesn't replace a full accessibility review.</p>
        </div>
        <div class="belief-cell">
          <div style="font-family:var(--font-mono);font-size:11px;color:var(--ink-3);letter-spacing:0.14em;margin-bottom:28px;text-transform:uppercase;">02 · Shipping</div>
          <h3 class="display" style="font-size:28px;margin-bottom:16px;letter-spacing:-0.02em;">Investigate a missing shipping rate.</h3>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.55;">Try a customer's destination with a sample package. Inspect the matched zone, compare package values, and see which methods need live checkout data.</p>
        </div>
        <div class="belief-cell">
          <div style="font-family:var(--font-mono);font-size:11px;color:var(--ink-3);letter-spacing:0.14em;margin-bottom:28px;text-transform:uppercase;">03 · Order cleanup</div>
          <h3 class="display" style="font-size:28px;margin-bottom:16px;letter-spacing:-0.02em;">Find the orders worth clearing out.</h3>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.55;">Filter stale orders by status and age. Run a dry scan before deleting anything. Completed, processing, and on-hold orders aren't included in cleanup.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How we ship -->
  <section class="section" style="background:var(--cream-2);">
    <div class="wrap">
      <div class="eyebrow" style="margin-bottom:16px;">Know what each tool does</div>
      <h2 class="display" style="font-size:clamp(36px,5vw,64px);margin-bottom:56px;max-width:20ch;">
        Useful details, <em>before you install.</em>
      </h2>
      <div class="principles-grid">
        <div class="card" style="padding:36px;">
          <div style="display:flex;gap:20px;align-items:baseline;margin-bottom:14px;">
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-text);letter-spacing:0.14em;">01</span>
            <h3 class="display" style="font-size:26px;letter-spacing:-0.015em;flex:1;">Fix common markup issues</h3>
          </div>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.6;padding-left:44px;">Accessibility Fixer works on storefront HTML. Review the individual fixes and choose what to apply to your store.</p>
        </div>
        <div class="card" style="padding:36px;">
          <div style="display:flex;gap:20px;align-items:baseline;margin-bottom:14px;">
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-text);letter-spacing:0.14em;">02</span>
            <h3 class="display" style="font-size:26px;letter-spacing:-0.015em;flex:1;">Shipping checks are read-only</h3>
          </div>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.6;padding-left:44px;">Shipping Rules Tester reads your configuration without changing settings or creating orders. It doesn't contact external shipping providers.</p>
        </div>
        <div class="card" style="padding:36px;">
          <div style="display:flex;gap:20px;align-items:baseline;margin-bottom:14px;">
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-text);letter-spacing:0.14em;">03</span>
            <h3 class="display" style="font-size:26px;letter-spacing:-0.015em;flex:1;">Preview before order cleanup</h3>
          </div>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.6;padding-left:44px;">Stale Order Cleaner's scan shows which records match your filters. Deletion is permanent, so review the preview and keep a backup before cleanup.</p>
        </div>
        <div class="card" style="padding:36px;">
          <div style="display:flex;gap:20px;align-items:baseline;margin-bottom:14px;">
            <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-text);letter-spacing:0.14em;">04</span>
            <h3 class="display" style="font-size:26px;letter-spacing:-0.015em;flex:1;">Check the scope first</h3>
          </div>
          <p style="font-size:15px;color:var(--ink-2);line-height:1.6;padding-left:44px;">Each listing explains the supported features and links to the current source or install page. Have a store-specific question? Email support@amazingplugins.com.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection questions={questions} />

  <!-- CTA -->
  <section class="cta-dark">
    <div class="ribbon-bg ribbon-anim" style="top:-30%;right:-20%;width:1200px;opacity:0.65;" aria-hidden="true">
      <svg viewBox="0 0 1000 320" fill="none" width="1200">
        <defs><linearGradient id="rg-cta" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#F4A93C" stop-opacity="0.9"/><stop offset="40%" stop-color="#F26B3A"/><stop offset="70%" stop-color="#E85A78"/><stop offset="100%" stop-color="#5B3A6B"/></linearGradient></defs>
        <path d="M 50 200 Q 200 80 380 180 T 720 220 Q 880 240 950 120" stroke="url(#rg-cta)" stroke-width="64" stroke-linecap="round" fill="none"/>
        <path d="M 50 200 Q 200 80 380 180 T 720 220 Q 880 240 950 120" stroke="rgba(255,255,255,0.25)" stroke-width="20" stroke-linecap="round" fill="none"/>
      </svg>
    </div>
    <div class="wrap" style="position:relative;">
      <h2 class="display cta-h2">
        Find the plugin you actually <em>need</em>.
      </h2>
      <p style="font-size:18px;color:var(--cream);max-width:50ch;margin-bottom:40px;">
        Explore the features and requirements, or ask us which tool fits your store.
      </p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/plugins/" class="btn btn-coral" style="padding:16px 28px;font-size:16px;">
          Browse plugins
          <svg viewBox="0 0 16 16" fill="none" width="14" height="14"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
        <a href="mailto:support@amazingplugins.com" class="btn btn-primary">Ask a question</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-wrap {
    position: relative;
    overflow: hidden;
    padding-top: 80px;
    padding-bottom: 120px;
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-h1 {
    font-size: clamp(56px, 8.5vw, 132px);
    max-width: 14ch;
    margin-bottom: 32px;
  }
  .hero-lede {
    margin-bottom: 40px;
  }
  .hero-btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-btns .btn { white-space: normal; }
  .product-tile { padding: 32px; min-height: 300px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; }
  .tile-description { font-size: 14px; line-height: 1.6; margin-top: 16px; }
  .tile-accessibility { background: linear-gradient(135deg, #98405F, #5B3A6B); color: #fff; }
  .tile-action { display: block; margin-top: 24px; font-size: 13px; font-weight: 600; }
  .review-badge { padding: 5px 10px; border: 1px solid rgba(255,255,255,0.5); border-radius: 999px; font-size: 12px; }
  .catalog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 56px;
    gap: 24px;
    flex-wrap: wrap;
  }
  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .beliefs-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 64px;
  }
  .beliefs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .belief-cell {
    background: var(--cream);
    padding: 36px;
    min-height: 320px;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .principles-grid .card { min-width: 0; overflow-wrap: anywhere; }

  .cta-dark {
    background: var(--ink);
    color: var(--cream);
    padding: 120px 0;
    position: relative;
    overflow: hidden;
  }
  .cta-h2 {
    /* The closing section uses an inverted surface in both themes. */
    font-size: clamp(48px, 7vw, 96px);
    max-width: 14ch;
    margin-bottom: 32px;
    color: var(--cream);
  }
  .cta-dark .btn-primary { border: 1px solid var(--cream); }

  @media (max-width: 900px) {
    .tiles-grid { grid-template-columns: repeat(2, 1fr); }
    .beliefs-header { grid-template-columns: 1fr; gap: 24px; }
    .beliefs-grid { grid-template-columns: 1fr; }
    .principles-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .tiles-grid { grid-template-columns: 1fr; }
  }

</style>
