---
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const canonicalSlug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
    return {
      params: { slug: canonicalSlug },
      props: { post, canonicalSlug },
    };
  });
}

const { post } = Astro.props;
const canonicalSlug = Astro.props.canonicalSlug ?? post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
const { title, description, pubDate, updatedDate, author, tags } = post.data;
const { Content } = await render(post);
const canonicalPath = `/blog/${canonicalSlug}/`;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// Article schema for rich results
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "AmazingPlugins",
    "url": "https://amazingplugins.com"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(canonicalPath, Astro.site).href
  }
};

---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="article">
  <!-- Breadcrumb Schema -->
  <BreadcrumbSchema items={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: title, url: canonicalPath }
  ]} />
  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <meta property="article:published_time" content={pubDate.toISOString()} />
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  <meta property="article:author" content={author} />
  <article class="blog-post">
    <header class="post-header">
      <div class="container container-narrow">
        <div class="post-meta">
          <span class="post-tag">{tags?.[0] ?? 'Accessibility'}</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {updatedDate && <time datetime={updatedDate.toISOString()}>Updated {formattedUpdatedDate}</time>}
          <span class="post-author">by {author}</span>
        </div>
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
      </div>
    </header>

    <div class="post-content">
      <div class="container container-narrow">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    background: var(--cream-2);
    color: var(--ink);
    padding: 4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    flex-wrap: wrap;
  }

  .post-tag {
    background: var(--color-primary-bg);
    color: var(--coral-deep);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .post-meta time, .post-author {
    color: var(--ink-3);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .post-description {
    font-size: 1.15rem;
    color: var(--ink-2);
    margin: 0;
    max-width: 680px;
    line-height: 1.6;
  }

  .post-content {
    padding: 3rem 0 5rem;
  }

  .container-narrow {
    max-width: 720px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Blog content typography */
  .post-content :global(h2) {
    font-size: 1.6rem;
    margin: 2.5rem 0 1rem;
    color: var(--color-heading);
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-heading);
  }

  .post-content :global(p) {
    line-height: 1.8;
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }

  .post-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
    line-height: 1.8;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--color-bg-alt);
    border-radius: 0 8px 8px 0;
  }

  .post-content :global(pre) {
    background: #1e293b;
    color: #e2e8f0;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .post-content :global(code) {
    background: var(--color-bg-alt);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.875em;
  }

  .post-content :global(strong) {
    font-weight: 700;
    color: var(--color-heading);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--line);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .post-content :global(th) {
    background: var(--cream-2);
    color: var(--ink);
    font-weight: 600;
  }
</style>
