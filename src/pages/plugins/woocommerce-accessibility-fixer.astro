---
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are all nine fixers free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All nine fixers are included in the free WordPress.org plugin. There is no Pro version."
      }
    },
    {
      "@type": "Question",
      "name": "Does the plugin add storefront JavaScript?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Some fixers add small inline scripts, including the skip-link and keyboard-trap fixes. Check performance on your own theme and checkout."
      }
    },
    {
      "@type": "Question",
      "name": "Does it work with my theme?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The plugin uses WordPress and WooCommerce hooks and selectors. Results depend on your theme and checkout setup, so test the changes on your store."
      }
    },
    {
      "@type": "Question",
      "name": "Will it break my store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each fixer is isolated and reversible. You can disable any fixer at any time from the admin panel."
      }
    },
    {
      "@type": "Question",
      "name": "Does this make my store fully accessible?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The fixers cover specific issues. You still need to test your theme, checkout, and content with a keyboard and screen reader."
      }
    }
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "AP Accessibility Fixer for WooCommerce",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "WooCommerce",
  "description": "Nine free fixers for specific accessibility issues on WooCommerce stores.",
  "url": "https://amazingplugins.com/plugins/woocommerce-accessibility-fixer/",
  "downloadUrl": "https://wordpress.org/plugins/amazingplugins-accessibility-fixer-for-woocommerce/",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free, with all nine fixers included"
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

<BaseLayout
  title="AP Accessibility Fixer for WooCommerce"
  description="Nine free fixers for WooCommerce accessibility issues, including missing image alt text, focus styles, form labels, and skip links."
>

  <!-- Breadcrumb Schema -->
  <BreadcrumbSchema items={[
    { name: "Home", url: "/" },
    { name: "Plugins", url: "/plugins/" },
    { name: "AP Accessibility Fixer for WooCommerce", url: "/plugins/woocommerce-accessibility-fixer/" }
  ]} />
  <!-- Hero -->
  <section class="plugin-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="badge badge-free">Free</span>
      </div>
      <h1>AP Accessibility Fixer for WooCommerce</h1>
      <p class="hero-desc">Run a scan, review the results, and choose from nine free fixers. They address specific issues such as missing product-image alt text, focus styles, form labels, and skip links.</p>
      <div class="hero-actions">
        <a href="https://wordpress.org/plugins/amazingplugins-accessibility-fixer-for-woocommerce/" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
          Install Free on WordPress.org →
        </a>
      </div>
      <p class="hero-note">All nine fixers are free. There is no Pro version.</p>
    </div>
  </section>

  <!-- What it fixes -->
  <section class="section">
    <div class="container">
      <h2 class="section-title text-center">What the nine fixers do</h2>
      <p class="section-sub text-center">Review each change on your own theme and checkout before relying on it.</p>

      <div class="fixes-grid">
        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">🖼</div>
          <h3>Alt Text for Product Images</h3>
          <p>Fills empty product-image alt text from the image or product title. Review the result for meaning and context.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">⌨</div>
          <h3>Keyboard Trap Escape</h3>
          <p>Adds an Escape-key handler for selected WooCommerce modals. Test tab order and other controls separately.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">🔘</div>
          <h3>Focus Indicators</h3>
          <p>Adds focus styles to selected WooCommerce controls. Theme controls outside those selectors still need checking.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">🏷</div>
          <h3>Form Labels</h3>
          <p>Adds accessible names to some unlabeled inputs in post content. Checkout templates need separate testing.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">🎨</div>
          <h3>Focus and Error Contrast Styles</h3>
          <p>Adds focus outlines and error borders to selected WooCommerce fields. It does not measure text contrast ratios.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">⬇</div>
          <h3>Skip Links</h3>
          <p>Adds a skip-to-content link through a small inline script so keyboard users can bypass navigation.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">🔗</div>
          <h3>Error Message Associations</h3>
          <p>Uses a small inline script to associate selected WooCommerce error messages with nearby form fields.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">🌐</div>
          <h3>Heading Hierarchy</h3>
          <p>Adjusts heading levels in post content when they skip a level. Check the resulting page structure manually.</p>
        </article>

        <article class="fix-card">
          <div class="fix-icon" aria-hidden="true">📝</div>
          <h3>Main Landmark</h3>
          <p>Adds a main landmark to a matching content wrapper when the page does not already have one.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width: 720px;">
      <h2 class="section-title">Frequently Asked Questions</h2>

      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-q">Are all nine fixers free?</summary>
          <p class="faq-a">Yes. All nine fixers are included in the free WordPress.org plugin. There is no Pro version.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does the plugin add storefront JavaScript?</summary>
          <p class="faq-a">Some fixers add small inline scripts, including the skip-link and keyboard-trap fixes. Check performance on your own theme and checkout.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does it work with my theme?</summary>
          <p class="faq-a">The plugin uses WordPress and WooCommerce hooks and selectors. Results depend on your theme and checkout setup, so test the changes on your store.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Will it break my store?</summary>
          <p class="faq-a">Each fixer is isolated and reversible. You can disable any fixer at any time from the admin panel.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does this make my store fully accessible?</summary>
          <p class="faq-a">No. The fixers cover specific issues. You still need to test your theme, checkout, and content with a keyboard and screen reader.</p>
        </details>
      </div>
      <p>Choosing a tool? Read the <a href="/blog/best-wcag-wordpress-plugins-compared/">WordPress accessibility plugin comparison</a> and our <a href="/blog/woocommerce-accessibility-plugin-comparison/">WooCommerce plugin versus widget review</a>. Both explain their sources and testing limits.</p>
    </div>
  </section>

</BaseLayout>

<style>
  .plugin-hero {
    padding: 5rem 0 4rem;
    background: linear-gradient(180deg, var(--cream-2), var(--cream));
    text-align: center;
  }

  .hero-badge-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
  }

  .badge-free { background: #d1fae5; color: #065f46; }

  .plugin-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .hero-desc {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 55ch;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .hero-note {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin-top: 1rem;
  }

  .section-title {
    margin-bottom: 0.75rem;
  }

  .section-sub {
    color: var(--color-text-light);
    margin-bottom: 3rem;
  }

  .fixes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .fix-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .fix-icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .fix-card h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .fix-card p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-q {
    font-weight: 600;
    font-size: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q::after {
    content: '+';
    font-size: 1.25rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  details[open] .faq-q::after {
    content: '−';
  }

  .faq-a {
    color: var(--color-text-light);
    line-height: 1.7;
    padding-bottom: 1.25rem;
    font-size: 0.9375rem;
  }
</style>
